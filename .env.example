# Copy to .env (or set in your shell) to enable the LLM reasoning layer.
# Without this, the agent runs fully in deterministic offline mode.

OPENAI_API_KEY=sk-...

# Optional: override the model. Default is gpt-4o-mini (cheap, fast,
# supports tool calling). Other good picks: gpt-4o, gpt-4-turbo.
# LLM_MODEL=gpt-4o-mini
